{
  "name": "coastal-portfolio",
  "version": "1.1.6",
  "private": true,
  "homepage": "https://masynnay.com/",
  "dependencies": {
    "animate.css": "^4.1.1",
    "bootstrap": "^5.3.0",
    "react": "^18.2.0",
    "react-bootstrap": "^2.8.0",
    "react-bootstrap-icons": "^1.8.2",
    "react-dom": "^18.2.0",
    "react-on-screen": "^2.1.1",
    "react-router-dom": "^6.26.1",
    "react-router-hash-link": "^2.4.3",
    "react-scripts": "^5.0.1",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "prestart": "node scripts/IndexPhotos.cjs && node scripts/PrepareRoms.cjs",
    "prebuild": "node scripts/IndexPhotos.cjs && node scripts/PrepareRoms.cjs",
    "lint": "eslint src --ext .js --max-warnings 0",
    "format": "prettier --write \"src/**/*.{js,css}\" \"scripts/*.cjs\" \"public/emulator/player.{js,css,html}\" \"public/demos/**/*.{js,css,html}\" \"package.json\" \".prettierrc.json\"",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"scripts/*.cjs\" \"public/emulator/player.{js,css,html}\" \"public/demos/**/*.{js,css,html}\" \"package.json\" \".prettierrc.json\"",
    "check:project": "node scripts/CheckProject.cjs",
    "verify:windfall-graphics": "node public/windfall-2026/verify-graphics.cjs && node public/windfall-2026/verify-assets.cjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "settings": {
      "testing-library/utils-module": "off",
      "testing-library/custom-renders": "off",
      "testing-library/custom-queries": "off"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
